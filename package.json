{
  "name": "@topodot/maplibre-gl-photosphere",
  "version": "1.0.1",
  "description": "Immersive 360-degree photosphere plugin for MapLibre GL JS (TopoDOT fork of maplibre-gl-photosphere): enter a panorama anchored at a geographic point, look around, exit back to the map",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "keywords": [
    "maplibre",
    "photosphere",
    "panorama",
    "street-view",
    "360"
  ],
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.0.0"
  },
  "devDependencies": {
    "jsdom": "^29.0.0",
    "maplibre-gl": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sh3rlck/maplibre-gl-photosphere.git"
  },
  "homepage": "https://github.com/Sh3rlck/maplibre-gl-photosphere",
  "bugs": {
    "url": "https://github.com/Sh3rlck/maplibre-gl-photosphere/issues"
  }
}
